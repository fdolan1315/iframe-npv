# Copy to .env and set for your deployment. Never commit .env.

# Set to 1 ONLY when the app sits behind a reverse proxy you control
# (the proxy must overwrite X-Forwarded-For, not append to a client value).
# Default is 0: forwarded headers are ignored and REMOTE_ADDR is used.
TRUST_PROXY=0

# Dev server port.
PORT=8000

# Absolute path to the auth database. Keep it OUTSIDE the web root in
# production so it can never be served even if static rules change.
# TSCI_DB=/home/youruser/private/auth.db
